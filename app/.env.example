# Public runtime identifiers. Copy this file to .env.local.
# Export with --clear after changing public values to avoid stale Metro transforms.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_CLARITY_WEB_PROJECT_ID=
EXPO_PUBLIC_CLARITY_MOBILE_PROJECT_ID=
EXPO_PUBLIC_TELEMETRY_ENVIRONMENT=production
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
EXPO_PUBLIC_TELEMETRY_IN_DEV=false
# Set true only after selecting Strict masking in the mobile Clarity project.
EXPO_PUBLIC_CLARITY_MOBILE_MASKING_READY=false

# Build-time source map configuration. The token must never use EXPO_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
# Set SENTRY_AUTH_TOKEN in the build environment or use sentry-cli login locally.
