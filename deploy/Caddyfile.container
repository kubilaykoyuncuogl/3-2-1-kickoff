{
	auto_https off
	admin off
}
:{$PORT} {
	encode gzip
	# yalnızca /ws Python'a gider; index ve /acct uçları dışarı açılmaz (handle blokları: try_files /ws'yi sayfaya çevirmesin)
	handle /ws {
		reverse_proxy 127.0.0.1:9081
	}
	handle {
		root * /app/web
		# sürümlü dosyalar (adında özet var) kalıcı önbellek; index.html her açılışta doğrulanır (eski sekme derdi)
		@static path /_expo/* /assets/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		@page not path /_expo/* /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
